<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Appliance only: the boot receiver relaunches the persona after a
         power cycle. Gated on device ownership at runtime. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- testOnly keeps `dpm remove-active-admin` working during appliance
         development, so ownership comes off without a factory reset. It
         makes EVERY install require `adb install -t`, and it must come off
         before this branch ever feeds a tester APK. -->
    <application
        android:name="com.hearth.app.HearthApp"
        android:testOnly="true"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hearth">

        <activity
            android:name="com.hearth.app.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Hearth"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The appliance's HOME. Off the appliance this filter is inert:
                 the launcher picker only appears if the user asks for it, and
                 the DPC sets Hearth as the persistent preferred HOME when it
                 owns the device. See wiki/raw/android-appliance-plan.md. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- The COVER SCREEN's home, and it is a different seat from the
                 one above. A folding phone's outer display is a secondary
                 display in the platform's sense, and what rests there is
                 chosen from this category alone. Note there is no
                 CATEGORY_HOME here: claiming the cover cannot disturb the
                 launcher on the inner display.

                 The seat is held today by
                 com.motorola.launcher.secondarydisplay, which declares exactly
                 this filter and nothing more. Declaring it makes Hearth a
                 candidate; being CHOSEN is a preference, and on the appliance
                 the DPC sets it. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Quick talk, the iOS hearth://talk deep link. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hearth" android:host="talk" />
            </intent-filter>
        </activity>

        <!-- The DPC the appliance plan provisions:
             adb shell dpm set-device-owner com.hearth/.DeviceOwnerReceiver
             Off the appliance it is never enabled. -->
        <receiver
            android:name="com.hearth.DeviceOwnerReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Boot relaunch and the debug kiosk exit, both no-ops unless the
             app is device owner. See Appliance.kt. -->
        <receiver
            android:name="com.hearth.ApplianceBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.hearth.ApplianceExitReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hearth.appliance.EXIT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
