+// Bits per RVQ code on disk. Fixed by the codec and declared the same way in
+// omnivoice-tts.cpp and omnivoice-codec.cpp; kept local to match them.
+static const int RVQ_CODE_BITS = 11;
+
+// A named voice: pre-encoded reference codes plus the transcript that goes
+// with them. Loaded once at startup and held for the process lifetime, so a
+// request costs a map lookup rather than a codec encode.
+struct named_voice {
+    std::vector<int32_t> tokens;
+    int                  T = 0;
+    std::string          text;
+};
+
+static bool read_text_file_local(const char * path, std::string & out) {
+    FILE * f = fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[Voice] FATAL: cannot open %s\n", path);
+        return false;
+    }
+    char   buf[4096];
+    size_t n;
+    out.clear();
+    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+        out.append(buf, n);
+    }
+    fclose(f);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) {
+        out.pop_back();
+    }
+    return true;
+}
+
+// --voice name:ref.rvq:ref.txt  ->  three colon-separated fields. Windows
+// drive letters would collide with ':' so the split walks from the right,
+// leaving any colons in the name itself alone.
+static bool parse_voice_arg(const char * arg, std::string & name, std::string & rvq, std::string & txt) {
+    std::string s   = arg;
+    size_t      p2  = s.find_last_of(':');
+    if (p2 == std::string::npos) {
+        return false;
+    }
+    size_t p1 = s.find_last_of(':', p2 - 1);
+    if (p1 == std::string::npos) {
+        return false;
+    }
+    name = s.substr(0, p1);
+    rvq  = s.substr(p1 + 1, p2 - p1 - 1);
+    txt  = s.substr(p2 + 1);
+    return !name.empty() && !rvq.empty() && !txt.empty();
+}
 
