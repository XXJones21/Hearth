# hearth.env, the generated configuration.
#
# THIS FILE IS A TEMPLATE AND A SPECIFICATION. The real one is written at
# install time to $HEARTH_HOME/config/hearth.env by scripts/render_config.py,
# from the hearth-install.json the client writes beside the weights. All three
# systemd units read it through EnvironmentFile=-%h/.hearth/config/hearth.env.
#
# It exists because four systemd drop-ins on one machine supplied configuration
# that no repository had ever seen, and roughly twenty hardware constants lived
# inside launch scripts as literals. An installer that cannot regenerate those
# has not installed the product. The single most valuable property of this file
# is that it is WRITTEN, so it can be READ BACK: it is the install record's
# runtime half, and it outlives a browser's localStorage.
#
# Every value below comes from something hearth-probe already computes. The
# "from" line on each entry names the field in the probe's plan or machine
# scan, so M13's installer can be written from this file alone.
#
# The "consumer" line is honest about what is wired today. Group D of the
# migration plan generates the file; it does not add new readers. A line marked
# `record only` is written so the value is not lost, and is waiting for the code
# that reads it.

# --- Where things are ------------------------------------------------------
# All three are also derived if absent, so a developer checkout runs without
# this file at all. The installer writes them anyway, because a written value
# is a value you can inspect after the fact.

# from: the install destination the client chose (record.weights_dir's parent)
# consumer: settings.py hearth_root(), config.rs hearth_root()
HEARTH_ROOT=/opt/hearth

# from: the product user's home
# consumer: settings.py hearth_home()
HEARTH_HOME=/home/hearth/.hearth

# from: record.weights_dir
# consumer: settings.py hearth_models(), the persona model resolver
HEARTH_MODELS=/home/hearth/.hearth/models

# from: seeded empty at first boot; NEVER copied from an existing tree
# consumer: settings.py hearth_engram(), memory/brain_sync.py, journal.py
# An unset value is a named failure rather than a search. That is deliberate:
# a memory root that searches is how a fresh install adopts someone else's.
HEARTH_ENGRAM=/home/hearth/.hearth/engram

# from: REL_ENGRAM_MCP; the memory client pack_backend.sh vendors into the
# backend bundle
# consumer: memory/service.py EngramService, the recall/remember deep tier
# Unset does not fail a turn: EngramService logs a warning and recall degrades
# to the legacy seams (operator facts and truncated note tops). The first
# ported house ran that way for weeks unnoticed, which is why the example
# names the line.
HEARTH_ENGRAM_MCP_PATH=/opt/hearth/runtime/backend/vendor/engram-mcp

# --- The model -------------------------------------------------------------

# from: plan.file, joined with record.weights_dir
# consumer: llama.rs, as the resident-model override
HEARTH_DEEP_MODEL_OVERRIDE=/home/hearth/.hearth/models/gemma-4-12B-it-qat-UD-Q4_K_XL.gguf

# from: plan.tier, as the dictionary id the persona manifests name
# consumer: record only. The persona manifests carry the id; this records
# which tier the install actually landed, for an upgrade to compare against.
HEARTH_MODEL_ID=gemma-4-12b-qat

# from: plan.n_ctx, planned against measured memory
# consumer: config.rs llama_ctx_override
# The Valinor unit hard-coded 16384 here and overrode every persona's declared
# context unconditionally. Leave this unset to let the persona's own n_ctx
# stand; set it only when the plan says the machine cannot hold that much.
HEARTH_LLAMA_CTX=65536

# from: plan.n_gpu_layers
# consumer: record only. The supervisor reads n_gpu_layers from the persona
# manifest today. This is the value the scan says the machine can offload.
HEARTH_LLAMA_NGL=48

# from: plan.backend (machine.gpu.backend)
# consumer: record only. cuda, metal, vulkan or cpu.
HEARTH_ACCEL=cuda

# from: plan.cuda_arch, derived from machine.gpu.compute_cap
# consumer: record only. This is the RUNTIME offload architecture, not the
# architecture anything was compiled for: we ship an upstream llama-server
# built for a range. The build-time pin lives in scripts/build_env.sh and runs
# on our builder.
HEARTH_CUDA_ARCH=89

# from: plan.coexist
# consumer: record only. False means the brain and the voice cannot both stay
# resident and have to take turns, which is the small-machine warning.
HEARTH_COEXIST=1

# --- Behaviour -------------------------------------------------------------

# was: the valar.service.d/zz-tts-omnivoice.conf drop-in
# consumer: settings.py VoiceConfig.tts_service_url
# Without this the harness dials :8701, the retired port, and Hearth is silent.
# This is the single line whose absence produces a product that looks healthy
# and says nothing.
HEARTH_TTS_SERVICE_URL=ws://127.0.0.1:18702/tts

# was: the valar.service.d/zz-tools.conf drop-in
# consumer: valar/tools/__init__.py
# The tool layer defaults to OFF. Without this the registry resolves to empty,
# which is indistinguishable from tools being switched off on purpose.
HEARTH_TOOLS_ENABLED=1

# was: the valinor-rust.service.d/reasoning.conf drop-in
# consumer: config.rs llama_reasoning
# "auto" parses reasoning out of responses and honours per-request thinking.
# "off" hard-caps the reasoning budget globally.
HEARTH_LLAMA_REASONING=auto

# --- Ports -----------------------------------------------------------------
# Hearth's own block, deliberately not the internal stack's 8700/8080/8765/
# 8766/8702. The client already dials 18700 by default, so a build that reaches
# a development machine finds nothing rather than finding the live house.

HEARTH_PORT=18700
HEARTH_LLAMA_PORT=18080
HEARTH_RUST_WS_PORT=18765
HEARTH_RUST_ASSET_PORT=18766
HEARTH_TTS_PORT=18702

# The harness and the supervisor address each other by URL, so the ports above
# are not enough on their own.
HEARTH_BRAIN_BASE_URL=http://127.0.0.1:18080/v1
HEARTH_LLAMA_BASE_URL=http://127.0.0.1:18080/v1
HEARTH_BRAIN_SWITCH_WS_URL=ws://127.0.0.1:18765

# --- Voice and speech ------------------------------------------------------

# from: nothing; a fixed product choice until the scan has an opinion
# consumer: settings.py VoiceConfig
HEARTH_TTS_BACKEND=remote
HEARTH_TTS_SERVICE=omnivoice
HEARTH_WHISPER_MODEL=base

# --- Locale ----------------------------------------------------------------

# from: the machine's locale at install time (config_gen reads sys-locale)
# consumer: tools/handlers/weather.py geocoding
# A bare place name resolves toward the machine's own country: a home
# machine's locale is honest signal about which same-named city its owner
# means ("Santa Clara" is Cuba's before California's by population). An
# explicit region in the query always outranks this.
HEARTH_REGION_BIAS=US

# --- What is deliberately NOT here -----------------------------------------
#
# The virtualenv paths, the llama-server binary location, the CUDA
# architecture used to COMPILE, the host compiler pin and the apt set. None of
# those are install-time questions once the image is the artifact; they are
# baked, and they live in scripts/build_env.sh.
#
# Wright's grounding paths, which pointed at one game project on one drive.
# They left with Wright.
