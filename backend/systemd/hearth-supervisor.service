[Unit]
Description=Hearth supervisor, the model control plane (:8765 control, :8766 assets)
After=network.target

[Service]
Type=simple
# No global model pin and no global context override. The active persona's
# declared model and n_ctx drive what becomes resident, and heavy personas swap
# in on demand through the harness router.
#
# The Valinor unit this replaces carried Environment=VALINOR_LLAMA_CTX=16384,
# which overrode every persona's declared context unconditionally and is the
# mechanism behind the long-standing issue where a persona asking for 65K kept
# receiving errors at 16K. It is gone rather than retuned: the probe plans
# context now, from measured memory, and writes it into hearth.env.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/lib/wsl/lib
EnvironmentFile=-%h/.hearth/config/hearth.env
ExecStart=/usr/bin/env bash @HEARTH_ROOT@/scripts/supervisor_run.sh
ExecStop=/usr/bin/env bash @HEARTH_ROOT@/scripts/supervisor_run.sh --stop
Restart=always
RestartSec=5
# A cold model load can take minutes. Never time the start out.
TimeoutStartSec=0

[Install]
WantedBy=default.target
