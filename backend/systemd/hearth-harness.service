[Unit]
Description=Hearth harness, the single client entry point (:8700)
# The harness is a CLIENT of the brain: the data plane on :8080 and the control
# plane on :8765, both of which the supervisor manages. Order after it so the
# brain is coming up first. The harness is resilient to a brain that is briefly
# unavailable; its warm-up is best effort and a turn retries the model swap.
# Only :8700 is exposed beyond this machine.
After=hearth-supervisor.service hearth-voice.service
Wants=hearth-supervisor.service hearth-voice.service

[Service]
Type=simple
# %h is the user's home, so no username appears anywhere in this file.
Environment=PATH=@HEARTH_ROOT@/venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/lib/wsl/lib
# Everything that varies per machine: the model, the context, the accelerator,
# the voice endpoint. Written at install time from the probe's plan. The
# leading dash means a missing file is not a start failure, which is right for
# a developer checkout and wrong for an install; install_units.sh says so when
# the file is absent.
EnvironmentFile=-%h/.hearth/config/hearth.env
ExecStart=/usr/bin/env bash @HEARTH_ROOT@/scripts/harness_run.sh
Restart=always
RestartSec=5
# Speech recognition load plus making the model resident can take a while
# against a cold brain. Never time the start out.
TimeoutStartSec=0

[Install]
WantedBy=default.target
