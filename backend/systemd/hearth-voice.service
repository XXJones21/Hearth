[Unit]
Description=Hearth voice service, OmniVoice (127.0.0.1:8702)
# Holds the speech model resident in its own process so a harness restart costs
# no GPU reload. Internal only. Its virtualenv is separate because its torch is
# newer than the one the harness is pinned to.
After=network.target

[Service]
Type=simple
Environment=PATH=@HEARTH_ROOT@/venv-voice/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/usr/lib/wsl/lib
EnvironmentFile=-%h/.hearth/config/hearth.env
ExecStart=/usr/bin/env bash @HEARTH_ROOT@/scripts/voice_run.sh
Restart=always
RestartSec=5
# Model load, clone prompt and CUDA prime. Never time out.
TimeoutStartSec=0

[Install]
WantedBy=default.target
